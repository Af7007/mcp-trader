    def _analyze_m5_trend(self, rates):
        """
        ANÁLISE ULTRA-AGGRESSIVE: Thresholds 70% menores para mais sinais
        
        CORREÇÃO: Thresholds 70% menores para gerar muito mais sinais
        """
        try:
            closes = [r['close'] for r in rates[:10]]
            highs = [r['high'] for r in rates[:10]]
            lows = [r['low'] for r in rates[:10]]
            volumes = [r['tick_volume'] for r in rates[:10]]

            current = closes[0]
            prev_1 = closes[1]
            prev_2 = closes[2]
            prev_5 = closes[5]

            # Calcular ATR para SL/TP dinâmico
            self.current_atr = self._calculate_atr_simple(rates[:14])

            # ULTRA-AGGRESSIVE: Tendência relaxada
            uptrend = sum(1 for i in range(3) if closes[i] > closes[i+1]) >= 2  # Reduzido de 3 para 2
            downtrend = sum(1 for i in range(3) if closes[i] < closes[i+1]) >= 2  # Reduzido de 3 para 2

            # ULTRA-AGGRESSIVE: Momentum 70% menor (mais fácil de atingir)
            momentum_5m = ((current - prev_5) / prev_5) * 100
            
            # CORREÇÃO: Usar thresholds mais baixos se ultra_aggressive
            if hasattr(self, 'ultra_aggressive') and self.ultra_aggressive:
                momentum_buy_threshold = getattr(self, 'momentum_buy_threshold', 0.01)
                momentum_sell_threshold = getattr(self, 'momentum_sell_threshold', -0.01)
                confirmations_required = getattr(self, 'confirmations_required', 1)
            else:
                momentum_buy_threshold = 0.03
                momentum_sell_threshold = -0.03
                confirmations_required = 2

            # ULTRA-AGGRESSIVE: Volatilidade relaxada
            last_range = highs[0] - lows[0]
            avg_range = sum([highs[i] - lows[i] for i in range(1, 6)]) / 5
            high_volatility = last_range > avg_range * 0.8  # Reduzido de 1.0 para 0.8

            # ULTRA-AGGRESSIVE: Volume relaxado
            volume_spike = volumes[0] > sum(volumes[1:6]) / 5 * 1.05  # Reduzido de 1.1 para 1.05

            # ULTRA-AGGRESSIVE: Preço vs média relaxado
            avg_price = sum(closes[:5]) / 5
            price_above_avg = current > avg_price
            price_below_avg = current < avg_price

            # Log de análise (apenas 10% das vezes para não spamar)
            import random
            if random.random() < 0.1:
                print(f"   [M5] Mom: {momentum_5m:.3f}% | ATR: {self.current_atr:.1f} | Trend: {'UP' if uptrend else 'DOWN' if downtrend else 'LATERAL'}")

            # === ULTRA-AGGRESSIVE: SINAIS BUY - 1 CONFIRMAÇÃO (vs 2 anterior) ===
            if self.use_buy:
                confirmations = 0

                # Confirmação 1: Tendência ou momentum forte
                if uptrend and momentum_5m > momentum_buy_threshold:
                    confirmations += 1
                elif momentum_5m > momentum_buy_threshold * 2:  # Momentum muito forte
                    confirmations += 1
                
                # Confirmação 2: Volume/volatility OU preço favorável (OR)
                if (high_volatility or volume_spike) and current > prev_1 and price_above_avg:
                    confirmations += 1
                
                # ULTRA-AGGRESSIVE: Requer apenas 1 confirmação (vs 2 anterior)
                if confirmations >= confirmations_required:  # 1 confirmação
                    # Verificar M15 (manter, mas mais relaxado)
                    if self._check_m15_trend_aggressive("BUY"):
                        return {"type": "BUY", "price": current, "reason": "ULTRA_AGGRESSIVE_M5_M15_buy"}

            # === ULTRA-AGGRESSIVE: SINAIS SELL - 1 CONFIRMAÇÃO (vs 2 anterior) ===
            if self.use_sell:
                confirmations = 0

                # Confirmação 1: Tendência ou momentum forte
                if downtrend and momentum_5m < momentum_sell_threshold:
                    confirmations += 1
                elif momentum_5m < momentum_sell_threshold * 2:  # Momentum muito forte
                    confirmations += 1
                
                # Confirmação 2: Volume/volatility OU preço favorável (OR)
                if (high_volatility or volume_spike) and current < prev_1 and price_below_avg:
                    confirmations += 1
                
                # ULTRA-AGGRESSIVE: Requer apenas 1 confirmação (vs 2 anterior)
                if confirmations >= confirmations_required:  # 1 confirmação
                    # Verificar M15 (manter, mas mais relaxado)
                    if self._check_m15_trend_aggressive("SELL"):
                        return {"type": "SELL", "price": current, "reason": "ULTRA_AGGRESSIVE_M5_M15_sell"}

            return None

        except Exception as e:
            print(f"Erro na analise M5: {e}")
            return None
    
    def _check_m15_trend_aggressive(self, signal_type: str) -> bool:
        """
        VERIFICAÇÃO M15 ULTRA-RELAXADA
        Permite sinais mesmo com tendência M15 neutra
        """
        try:
            rates_m15 = self.mt5.copy_rates_from_pos(
                symbol=self.symbol,
                timeframe="M15",
                start_pos=0,
                count=4
            )

            if len(rates_m15) < 3:
                return True  # Se poucos dados, permitir (ultra-aggressive!)

            closes = [r['close'] for r in rates_m15[:3]]

            # ULTRA-RELAXADO: Não exige tendência forte
            if signal_type == "BUY":
                # Para BUY: Aceita uptrend OU preço atual acima da média
                uptrend_m15 = closes[0] > closes[1] > closes[2]
                price_above_recent = closes[0] > sum(closes) / len(closes)
                return uptrend_m15 or price_above_recent

            if signal_type == "SELL":
                # Para SELL: Aceita downtrend OU preço atual abaixo da média
                downtrend_m15 = closes[0] < closes[1] < closes[2]
                price_below_recent = closes[0] < sum(closes) / len(closes)
                return downtrend_m15 or price_below_recent

            return True  # Padrão: permitir (ultra-aggressive!)

        except Exception as e:
            print(f"   Erro ao verificar M15: {e}")
            return True  # Se falhar, permitir (ultra-aggressive!)

    def _check_m15_trend(self, signal_type: str) -> bool:
        """
        Override do método original para usar versão ultra-relaxada
        """
        return self._check_m15_trend_aggressive(signal_type)

    def _calculate_atr_simple(self, rates):
        """
        ATR ULTRA-OTIMIZADO: Força valores menores para trailing mais responsivo
        """
        try:
            if len(rates) < 14:
                # ATR MÍNIMO forçado para garantir ativação rápida
                return 200.0  # Reduzido de 400.0 para 200.0 (50% menor)

            true_ranges = []
            for i in range(1, min(14, len(rates))):
                high = rates[i-1]['high']
                low = rates[i-1]['low']
                prev_close = rates[i]['close']

                tr = max(
                    high - low,
                    abs(high - prev_close),
                    abs(low - prev_close)
                )
                true_ranges.append(tr)

            atr_preco = sum(true_ranges) / len(true_ranges)
            atr_pontos = atr_preco / self.symbol_point

            # ULTRA-OTIMIZADO: Força ATR menor para trailing mais rápido
            atr_minimo = 150.0  # Reduzido de 400.0 para 150.0 (62% menor!)
            
            resultado = max(atr_pontos, atr_minimo)
            
            # Log de debug (apenas 5% das vezes)
            import random
            if random.random() < 0.05:
                print(f"   [ATR] Calculado: {atr_pontos:.0f} pts | Aplicado: {resultado:.0f} pts | Mínimo: {atr_minimo} pts")
            
            return resultado

        except Exception as e:
            print(f"   Erro ao calcular ATR: {e}")
            return 150.0  # ATR mínimo forçado (vs 400.0 anterior)
    
    def _open_position(self, signal: dict):
        """
        ABERTURA ULTRA-AGGRESSIVE com thresholds forçados
        """
        try:
            print(f"\n[ULTRA-AGGRESSIVE] Abrindo posição {signal['type']} - THRESHOLDS FORÇADOS")
            
            # Log do reason para identificar origem do sinal
            reason = signal.get('reason', 'UNKNOWN')
            print(f"   Razão do sinal: {reason}")
            
            # Calcular thresholds atuais
            if self.current_atr == 0:
                self.current_atr = 150.0  # Forçado
            
            # ULTRA-AGGRESSIVE: Thresholds forçados (independentemente do cálculo anterior)
            self.current_sl_pontos = self.current_atr * 3.0          # 3x ATR (vs 5.0 anterior)
            self.current_trailing_activation_pontos = self.current_atr * 0.05   # 5% ATR (vs 35% anterior)
            self.current_trailing_distance_pontos = self.current_atr * 0.02    # 2% ATR (vs 13% anterior)
            
            # Valores em dinheiro
            sl_dinheiro = self._pontos_para_dinheiro(self.current_sl_pontos)
            trailing_activation_dinheiro = self._pontos_para_dinheiro(self.current_trailing_activation_pontos)
            trailing_distance_dinheiro = self._pontos_para_dinheiro(self.current_trailing_distance_pontos)
            
            print(f"   Thresholds FORÇADOS:")
            print(f"     SL: {self.current_sl_pontos:.0f} pts (${sl_dinheiro:.2f})")
            print(f"     Trailing Ativa: {self.current_trailing_activation_pontos:.0f} pts (${trailing_activation_dinheiro:.2f})")
            print(f"     Trailing Distância: {self.current_trailing_distance_pontos:.0f} pts (${trailing_distance_dinheiro:.2f})")
            print(f"     Lucro Mínimo Protegido: ${trailing_activation_dinheiro - trailing_distance_dinheiro:.2f}")
            
            # Verificar se thresholds são razoáveis
            if trailing_activation_dinheiro < 0.10:
                print(f"   [WARNING] Trailing muito baixo (${trailing_activation_dinheiro:.2f}), ajustando...")
                self.current_trailing_activation_pontos = 100.0  # Mínimo 100 pts
                trailing_activation_dinheiro = self._pontos_para_dinheiro(self.current_trailing_activation_pontos)
            
            # Chama método da classe pai com thresholds modificados
            print(f"\n   Chamando método da classe pai com thresholds ULTRA-AGGRESSIVE...")
            super()._open_position(signal)
            
        except Exception as e:
            print(f"   Erro na abertura ultra-aggressive: {e}")
            # Fallback: tentar método original
            print(f"   [FALLBACK] Tentando método original...")
            super()._open_position(signal)


