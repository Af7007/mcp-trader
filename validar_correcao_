import sys
import os
from pathlib import Path

# Adicionar src ao path
sys.path.insert(0, str(Path(__file__).parent / "src"))

def test_ultra_aggressive_parameters():
    """
    Testa se os parâmetros ultra-aggressive estão sendo aplicados corretamente
    """
    print("="*70)
    print("VALIDAÇÃO: AGENTE ADAPTIVE ULTRA-AGGRESSIVE")
    print("="*70)
    
    # Verificar se o arquivo corrigido existe
    corrected_file = Path("agente_adaptive_corrigido_ultra_aggressive.py")
    if not corrected_file.exists():
        print(f"[❌ ERRO] Arquivo corrigido não encontrado: {corrected_file}")
        return False
    
    print(f"[✅] Arquivo corrigido encontrado: {corrected_file}")
    
    # Ler o arquivo e verificar se contém as correções
    try:
        with open(corrected_file, 'r', encoding='utf-8') as f:
            content = f.read()
        
        corrections_found = []
        
        # Verificar correção 1: trailing_activation_atr_multiplier = 0.05
        if 'trailing_activation_atr_multiplier = 0.05' in content:
            corrections_found.append("Trailing ativo 5% ATR ($0.24 lucro)")
        else:
            print("[❌] Correção trailing ativa não encontrada")
        
        # Verificar correção 2: trailing_distance_atr_multiplier = 0.02
        if 'trailing_distance_atr_multiplier = 0.02' in content:
            corrections_found.append("Trailing distância 2% ATR ($0.10)")
        else:
            print("[❌] Correção trailing distância não encontrada")
        
        # Verificar correção 3: stop_loss_atr_multiplier = 3.0
        if 'stop_loss_atr_multiplier = 3.0' in content:
            corrections_found.append("Stop Loss 3x ATR ($3.60)")
        else:
            print("[❌] Correção Stop Loss não encontrada")
        
        # Verificar correção 4: confirmations_required = 1
        if 'confirmations_required = 1' in content:
            corrections_found.append("1 confirmação apenas")
        else:
            print("[❌] Correção confirmações não encontrada")
        
        # Verificar correção 5: auto_tuning_enabled = False
        if 'auto_tuning_enabled = False' in content:
            corrections_found.append("Auto-learning desabilitado")
        else:
            print("[❌] Correção auto-learning não encontrada")
        
        # Verificar correção 6: ATR mínimo forçado
        if 'atr_minimo = 150.0' in content:
            corrections_found.append("ATR mínimo 150 pts")
        else:
            print("[❌] Correção ATR não encontrada")
        
        print(f"\n[✅] CORREÇÕES IMPLEMENTADAS: {len(corrections_found)}/6")
        for correction in corrections_found:
            print(f"   ✓ {correction}")
        
        if len(corrections_found) >= 5:
            print(f"\n[✅] VALIDAÇÃO APROVADA: Agente ultra-aggressive configurado!")
            print(f"   Resultado esperado: 15-30 operações/hora")
            print(f"   Lucro protegido: $0.24+ (vs $1.65 anterior)")
            return True
        else:
            print(f"\n[❌] VALIDAÇÃO FALHOU: Algumas correções não foram implementadas")
            return False
            
    except Exception as e:
        print(f"[❌] Erro ao ler arquivo: {e}")
        return False

def compare_with_original():
