    # Simular thresholds mais baixos
    original_momentum_threshold = 0.03  # 0.03%
    corrected_momentum_threshold = 0.01  # 0.01%
    
    print(f"Thresholds de momentum:")
    print(f"   Original: {original_momentum_threshold}% (requer movimento maior)")
    print(f"   Corrigido: {corrected_momentum_threshold}% (requer movimento menor)")
    print(f"   Melhoria: {((original_momentum_threshold - corrected_momentum_threshold) / original_momentum_threshold * 100):.0f}% mais sensível")
    
