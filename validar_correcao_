    """
    print(f"\n" + "="*70)
    print("COMPARAÇÃO: ORIGINAL vs CORRIGIDO")
    print("="*70)
    
    comparison_table = [
        ["Parâmetro", "ORIGINAL (Conservador)", "CORRIGIDO (Ultra-Aggressive)", "Melhoria"],
        ["-"*20, "-"*20, "-"*20, "-"*20],
        ["Trailing Ativa", "35% ATR = $1.65", "5% ATR = $0.24", "585% mais sensível"],
        ["Confirmações", "2 necessárias", "1 necessária", "100% mais sinais"],
        ["ATR Mínimo", "400 pts", "150 pts", "62% menor"],
        ["Auto-Learning", "Ativo", "Desabilitado", "Mantém agressividade"],
        ["Verificação", "15s", "10s", "33% mais frequente"],
        ["Volume", "0.01 lotes", "0.03 lotes", "200% maior"],
